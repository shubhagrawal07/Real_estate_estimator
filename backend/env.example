# Database Configuration (PostgreSQL)
# Update DB_USERNAME to match your PostgreSQL username
# If no password is set, leave DB_PASSWORD empty
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=shubhagrawal
DB_PASSWORD=
DB_NAME=real_estate_db

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
JWT_SECRET=your_jwt_secret_key_here

# DVF Open Data API (optional)
# DVF_API_BASE_URL=https://apidf-preprod.cerema.fr/dvf_opendata/mutations/
# DVF_API_TIMEOUT_MS=90000

# Truncate city_block_sales_data and load backend/sql/city_block_sales_data.sql on startup.
# Defaults to on when NODE_ENV is not production. Set to false to skip, or true to force (e.g. in prod).
# REFRESH_CITY_BLOCK_SALES_DATA_ON_STARTUP=true